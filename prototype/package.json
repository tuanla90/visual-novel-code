{
  "name": "clb-tham-tu-du-lieu-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "predev": "npm run -s noi-dung:sinh",
    "dev": "vite",
    "start": "node server.mjs",
    "prebuild": "npm run -s noi-dung:sinh",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --maxWorkers=2",
    "lint": "eslint .",
    "kiem-noi-dung": "node --import ./tools/noi-dung/nap-ts.mjs tools/noi-dung/kiem.ts && npm run -s kiem-noi-dung:mvp",
    "noi-dung:sinh": "node --import ./tools/noi-dung/nap-ts.mjs tools/noi-dung/sinh.ts && npm run -s noi-dung:sinh:mvp",
    "kiem-to-mau": "vitest run src/mvp/ui/to-mau-luat.test.ts",
    "kiem-giong": "node --import ./tools/noi-dung/nap-ts.mjs tools/noi-dung/kiem-giong.ts",
    "kiem-noi-dung:mvp": "node --import ./tools/noi-dung/nap-ts.mjs tools/noi-dung/kiem-mvp.ts",
    "noi-dung:sinh:mvp": "node --import ./tools/noi-dung/nap-ts.mjs tools/noi-dung/sinh-mvp.ts",
    "noi-dung:sinh:mua1": "node --import ./tools/noi-dung/nap-ts.mjs tools/noi-dung/sinh-mua1.ts",
    "kiem-noi-dung:mua1": "node --import ./tools/noi-dung/nap-ts.mjs tools/noi-dung/kiem-mua1.ts",
    "noi-dung:sinh:thu-b19": "node --import ./tools/noi-dung/nap-ts.mjs tools/noi-dung/sinh-thu-b19.ts",
    "kiem-noi-dung:thu-b19": "node --import ./tools/noi-dung/nap-ts.mjs tools/noi-dung/sinh-thu-b19.ts --kiem",
    "noi-dung:sinh:thu-b21": "node --import ./tools/noi-dung/nap-ts.mjs tools/noi-dung/sinh-thu-b21.ts",
    "kiem-noi-dung:thu-b21": "node --import ./tools/noi-dung/nap-ts.mjs tools/noi-dung/sinh-thu-b21.ts --kiem",
    "kiem-giong:mua1": "node --import ./tools/noi-dung/nap-ts.mjs tools/noi-dung/kiem-giong.ts --noi-dung noi-dung-mua-1",
    "kiem-ky-nang:mua1": "node --import ./tools/noi-dung/nap-ts.mjs tools/noi-dung/kiem-ky-nang.ts",
    "truyen-chu:mua1": "node --import ./tools/noi-dung/nap-ts.mjs tools/truyen-chu.ts"
  },
  "dependencies": {
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/playwrite-in": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sql.js": "^1.14.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
