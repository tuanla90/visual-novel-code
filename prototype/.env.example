# Server-only AI companion configuration. Copy to .env.local and fill in any available key.
# Auto priority: DeepSeek -> Gemini -> OpenAI, with fallback on API failures.
AI_PROVIDER=auto
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional model overrides. These are the defaults.
DEEPSEEK_MODEL=deepseek-flash
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_MODEL=gpt-6-astra

# To use one service exclusively: AI_PROVIDER=deepseek, gemini, or openai.
